# ============================================================
# QA Manager - 환경변수 템플릿
# 실제 값은 .env 파일로 복사해서 사용 (Git에 커밋 금지)
# ============================================================

# ─────────────── MariaDB ───────────────
# 호스트 직접 실행:    DB_HOST=localhost
# docker compose 사용: DB_HOST=db
DB_HOST=db
DB_PORT=3306
DB_NAME=qa_manager
DB_USER=qa_manager
DB_PASSWORD=
# docker compose 만 사용 (mariadb 컨테이너 초기 root 비밀번호)
DB_ROOT_PASSWORD=

# ─────────────── Spring ───────────────
# 운영은 prod (logs INFO+, sql 숨김), 로컬 개발은 local 권장.
SPRING_PROFILES_ACTIVE=prod

# ─────────────── JWT ───────────────
# 운영 시 충분히 긴 시크릿(>= 64 chars) 사용. 미설정 시 부팅 실패.
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars-long-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# ─────────────── AWS S3 ───────────────
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# presigned URL 만료(초)
AWS_S3_PRESIGN_TTL_SECONDS=300

# ─────────────── CORS ───────────────
# 프론트엔드 도메인. 여러 개면 콤마 구분.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────── Auth Cookie ───────────────
# JWT 토큰을 HttpOnly 쿠키로 발행한다.
# 운영(HTTPS)에서는 반드시 COOKIE_SECURE=true 로 설정.
# 로컬 개발(HTTP)에서만 false 유지.
COOKIE_SECURE=false
# 동일 사이트 정책. Lax(권장) / Strict / None
COOKIE_SAME_SITE=Lax

# ─────────────── Redis (토큰 블랙리스트) ───────────────
# docker compose 환경에서는 redis (서비스 이름)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# teams bot secret
TEAMS_ENABLED=true
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
TEAMS_BOT_USER_OID=

# ─────────────── Frontend ───────────────
# Nuxt 빌드/런타임에서 백엔드 API 호출 시 사용.
# 브라우저에서 접근 가능한 호스트로 지정해야 한다 (compose 내부 hostname 아님).
NUXT_PUBLIC_API_BASE=http://localhost:8080
# ============================================================
# QA Manager - 환경변수 템플릿
# 실제 값은 .env 파일로 복사해서 사용 (Git에 커밋 금지)
# ============================================================

# ─────────────── MariaDB ───────────────
# 호스트 직접 실행:    DB_HOST=localhost
# docker compose 사용: DB_HOST=db
DB_HOST=db
DB_PORT=3306
DB_NAME=qa_manager
DB_USER=qa_manager
DB_PASSWORD=
# docker compose 만 사용 (mariadb 컨테이너 초기 root 비밀번호)
DB_ROOT_PASSWORD=

# ─────────────── Spring ───────────────
# 운영은 prod (logs INFO+, sql 숨김), 로컬 개발은 local 권장.
SPRING_PROFILES_ACTIVE=prod

# ─────────────── JWT ───────────────
# 운영 시 충분히 긴 시크릿(>= 64 chars) 사용. 미설정 시 부팅 실패.
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars-long-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# ─────────────── AWS S3 ───────────────
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# presigned URL 만료(초)
AWS_S3_PRESIGN_TTL_SECONDS=300

# ─────────────── CORS ───────────────
# 프론트엔드 도메인. 여러 개면 콤마 구분.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────── Auth Cookie ───────────────
# JWT 토큰을 HttpOnly 쿠키로 발행한다.
# 운영(HTTPS)에서는 반드시 COOKIE_SECURE=true 로 설정.
# 로컬 개발(HTTP)에서만 false 유지.
COOKIE_SECURE=false
# 동일 사이트 정책. Lax(권장) / Strict / None
COOKIE_SAME_SITE=Lax

# ─────────────── Redis (토큰 블랙리스트) ───────────────
# docker compose 환경에서는 redis (서비스 이름)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────── MS Teams 알림 ───────────────
# Teams Bot Framework 프로액티브 1:1 메세지.
# 모든 값이 비어 있거나 TEAMS_ENABLED=false 면 발송 비활성화 (다른 알림은 정상 동작).
#
# 선행 작업(필수): Azure Portal 에서 Azure Bot 리소스 생성 → Teams 채널 활성화 →
#   Messaging endpoint 를 https://<백엔드 공개도메인>/api/teams/messages 로 설정 →
#   Teams 앱 매니페스트(bots[].scopes=["personal"]) 배포 → 각 사용자가 봇을 수동 설치.
#   봇 미설치 사용자에게는 403(미설치)로 발송되지 않는다.
TEAMS_ENABLED=false
# Graph 조회용 Azure AD 앱 등록 (email -> AAD Object ID 변환)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# Bot Connector 발송용: Azure Bot 리소스의 Microsoft App ID / client secret
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
# Bot Connector 토큰 발급 tenant. 멀티테넌트 봇이면 botframework.com,
# 싱글테넌트 봇이면 회사 tenant id (TEAMS_TENANT_ID 와 동일할 수 있음).
TEAMS_BOT_TENANT_ID=botframework.com
# serviceUrl 글로벌 기본값. 보통 그대로 둔다 (인바운드 이벤트의 serviceUrl 이 우선).
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/
# 회사 메일 도메인. username 이 이 도메인으로 끝나는 멤버만 Teams 발송 대상.
# 빈 값이면 도메인 검사 없이 모든 email 형식 username 을 시도.
TEAMS_EMAIL_DOMAIN=
# Graph / Bot Connector 호출 timeout (초). 기본값 사용해도 무방.
TEAMS_CONNECT_TIMEOUT=5
TEAMS_READ_TIMEOUT=10

# ─────────────── 로그인 보안 (IP 기반 이메일 OTP) ───────────────
# 신뢰 IP 밖에서 로그인 시 이메일 6자리 인증 코드를 요구한다.
# 기본 false(현행 동작). 켜기 전 아래 SMTP + 신뢰 IP 설정과 전 멤버 이메일 등록이 선행돼야 한다.
SECURITY_IP_OTP_ENABLED=false
# OTP 면제 대상 신뢰 IP/CIDR (콤마 구분). 예: 203.0.113.0/24,198.51.100.7/32
# ⚠️ 비우고 ENABLED=true 면 전원이 OTP 대상이 된다. 활성화 시 반드시 사무실 IP 를 채울 것.
SECURITY_TRUSTED_CIDRS=
# 신뢰 프록시 hop 수 (nginx 1단=1). X-Forwarded-For 위조 방지 판정 기준.
# ⚠️ nginx 가 클라이언트 XFF 를 그대로 흘리지 않고 자신이 본 remote_addr 를 append 하도록 구성돼야 한다.
SECURITY_TRUSTED_PROXY_COUNT=1
# OTP 메일 발신 표시 주소.
SECURITY_OTP_MAIL_FROM=QA Manager <no-reply@intocns.com>

# ─────────────── SMTP (로그인 OTP 메일 발송) ───────────────
# 비어 있으면 OTP 메일이 발송되지 않는다(로그 경고). OTP 활성화 시 필수.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─────────────── Frontend ───────────────
# Nuxt 빌드/런타임에서 백엔드 API 호출 시 사용.
# 브라우저에서 접근 가능한 호스트로 지정해야 한다 (compose 내부 hostname 아님).
NUXT_PUBLIC_API_BASE=http://localhost:8080
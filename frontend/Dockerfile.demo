# syntax=docker/dockerfile:1.7
# 데모 전용 이미지: 백엔드/DB 없이 정적 SPA(localStorage mock)만 nginx 로 서빙.
# 운영용 frontend/Dockerfile(SSR Node 서버)과는 별개다.

# ────────── Stage 1: 정적 생성 ──────────
FROM node:22-alpine AS build
WORKDIR /app

# 의존성 캐싱
# node:22-alpine 의 npm@10 은 로컬 npm@11 이 쓴 lockfile 을 읽지 못하는 케이스가 있어
# npm 메이저를 로컬과 맞춘다 (frontend/Dockerfile 과 동일한 이유).
COPY package.json package-lock.json ./
RUN npm install -g npm@^11 --no-fund --no-audit && npm ci

COPY . .
# DEMO_BUILD=true → ssr off + demoMode on (nuxt.config.ts). 결과는 .output/public.
RUN DEMO_BUILD=true npm run generate

# ────────── Stage 2: nginx 정적 서빙 ──────────
FROM nginx:1.27-alpine
COPY nginx.demo.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/.output/public /usr/share/nginx/html
EXPOSE 80

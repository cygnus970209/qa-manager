{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "your-bot-id",
  "developer": {
    "name": "QA Manager",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "QA Manager",
    "full": "QA Manager 알림"
  },
  "description": {
    "short": "QA Manager 의 QA/댓글 알림을 Teams 로 받습니다.",
    "full": "QA Manager 에서 발생하는 QA 등록·댓글·답글 등의 알림을 1:1 채팅으로 보내는 알림 봇입니다. 봇을 추가하면 본인에게 할당된 QA 변경 사항을 Teams 에서 바로 확인할 수 있습니다."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#5B5FC7",
  "bots": [
    {
      "botId": "your-bot-id",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": true
    }
  ],
  "permissions": ["identity"],
  "validDomains": []
}
